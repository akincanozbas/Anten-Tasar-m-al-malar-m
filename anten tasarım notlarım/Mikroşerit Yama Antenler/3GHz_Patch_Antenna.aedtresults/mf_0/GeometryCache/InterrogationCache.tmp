$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=true
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '6'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -30, -30, -0]
				High[3: 30, 30, 0]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '6'
		$begin '18'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -30, -30, 0]
				High[3: 30, 30, 1.6000000000000001]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '18'
		$begin '46'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -15.210000000000001, -30, 1.6000000000000001]
				High[3: 15.199999999999999, 11.710000000000001, 1.6000000000000001]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '46'
		$begin '102'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'Properties'
				Volume='0'
				Area='4.7999999999999998'
				Valid=true
			$end 'Properties'
			$begin 'BoundingBox'
				Low[3: -1.5, -30, -0]
				High[3: 1.4999999999999996, -30, 1.6000000000000001]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '102'
		$begin '114'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -50, -50, -25]
				High[3: 50, 50, 25]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '114'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
